# ==============================================================================
# GenAI Community VIT Bhopal - Environment Variables Template
# Copy these keys into your Vercel / Render Project Settings (Environment Variables)
# ==============================================================================

# --- Application URL ---
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# --- Supabase Database & Auth (Required) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# --- Google Cloud Service Account (For Drive & Sheets) ---
# Create a Service Account in Google Cloud Console with Drive & Sheets API enabled.
GOOGLE_SERVICE_ACCOUNT_EMAIL="genai-club-service-account@your-gcp-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# --- Google Drive Storage ---
# Root folder ID or Shared Drive ID where images and payment proofs are stored
GOOGLE_DRIVE_ROOT_FOLDER_ID="your_google_drive_folder_id"
GOOGLE_SHARED_DRIVE_ID="" # Optional: If using Google Workspace Shared Drive

# --- Google Sheets 3-Workbook Split Architecture ---
# Master or individual spreadsheet IDs
GOOGLE_SPREADSHEET_ID_EVENTS="your_event_operations_spreadsheet_id"
GOOGLE_SPREADSHEET_ID_LOGS="your_website_logs_spreadsheet_id"
GOOGLE_SPREADSHEET_ID_INTERNAL="your_internal_management_spreadsheet_id"
GOOGLE_SPREADSHEET_ID="fallback_spreadsheet_id" # Fallback if specific IDs are not provided

# --- Google Apps Script + Gmail Transactional Email Engine (100% Free) ---
# Deploy Code.gs as a Web App (Access: Anyone) and paste the Web App URL below:
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbx.../exec"
GOOGLE_APPS_SCRIPT_TOKEN="GENAI_GAS_EMAIL_SECRET_2026"
EMAIL_SENDER_NAME="GENAI Community VIT Bhopal"
EMAIL_REPLY_TO="gen_ai@vitbhopal.ac.in"
EMAIL_BATCH_SIZE="15"
EMAIL_DELAY_MS="250"
EMAIL_MAX_RETRIES="3"

# --- Gemini Generative AI (For LinkedIn Social Media AI Agent) ---
GEMINI_API_KEY="your-gemini-api-key"

# --- Gmail Automated Notifications (Transfers, Receipts, QR Passes Fallback) ---
# Google Account email and 16-character App Password (from Google Account Security)
GMAIL_USER="genaicommunityvitbofficial@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# --- Fallback Admin Credentials (For Offline/Emergency Access) ---
HARDCODED_ADMIN_EMAIL="admin.club.core@genai.local"
HARDCODED_ADMIN_PASSWORD="YourSecurePasswordHere"

# --- Vercel Cron Security ---
CRON_SECRET="your-secure-random-cron-secret"

# --- Privacy-Preserving Analytics (Optional) ---
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX" # Google Analytics 4 Measurement ID (No PII is collected)

# --- Production Rate Limiting Configuration ---
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_GENERAL_REQUESTS="100"
RATE_LIMIT_GENERAL_WINDOW_SECONDS="60"
RATE_LIMIT_REGISTRATION_REQUESTS="10"
RATE_LIMIT_REGISTRATION_WINDOW_SECONDS="600"
RATE_LIMIT_AUTH_REQUESTS="5"
RATE_LIMIT_AUTH_WINDOW_SECONDS="600"
RATE_LIMIT_PAYMENT_REQUESTS="5"
RATE_LIMIT_PAYMENT_WINDOW_SECONDS="600"
RATE_LIMIT_SCAN_REQUESTS="120"
RATE_LIMIT_SCAN_WINDOW_SECONDS="60"
RATE_LIMIT_EMAIL_REQUESTS="10"
RATE_LIMIT_EMAIL_WINDOW_SECONDS="3600"

# --- Optional Integration Webhooks & Relay ---
GOOGLE_DRIVE_RELAY_URL="" # Google Apps Script Web App URL for personal 15GB Drive uploads
GOOGLE_FORM_WEBHOOK_URL=""

