# ==============================================================================
# GenAI Club Website - Production .gitignore
# Ensures clean repository pushes without leaking secrets, local build artifacts,
# temporary caches, or system files.
# ==============================================================================

# --- Dependencies ---
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Testing & Coverage ---
/coverage
*.lcov

# --- Next.js Build Outputs ---
/.next/
/out/
/build/
dist/

# --- Environment & Secret Files (CRITICAL: Never commit credentials) ---
.env
.env*.local
.env.development
.env.test
.env.production
.env.local
!.env.example

# --- Certificates, Private Keys & Tokens ---
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
*.pub

# --- Logs & Debug Dumps ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# --- Operating System Caches ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDE & Editor Settings ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Vercel & Cloud Provider Local Artifacts ---
.vercel/

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- System & Agent Artifacts ---
.system_generated/
.gemini/
scratch/

# --- Confidential Internal Handover Documentation ---
HANDOVER_BOOK.md
*.pdf
scripts/generate_pdf_handbook.py
